DATABASE_URL=postgresql://user:password@localhost:5432/codestart
PGHOST=localhost
PGUSER=user
PGPASSWORD=password
PGDATABASE=codestart
PGPORT=5432

# SMTP Configuration (Required for Email Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# OR use Resend (Highly Recommended for production)
RESEND_API_KEY=re_your_api_key
